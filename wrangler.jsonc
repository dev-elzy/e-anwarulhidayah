{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "e-anwarulhidayah",
  "main": ".open-next/worker.js",
  "compatibility_date": "2025-02-04",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "hyperdrive": [
    {
      "binding": "HYPERDRIVE",
      "id": "c63805c58ef9480295346cd7f0feaaee"
    }
  ],
  "routes": [
    {
      "pattern": "anwarulhidayah.develzy.my.id",
      "custom_domain": true
    }
  ],
  "vars": {
    "SUPABASE_URL": "https://ylmddkafujvmilaticrm.supabase.co",
    "NEXT_PUBLIC_SUPABASE_URL": "https://ylmddkafujvmilaticrm.supabase.co",
    "NEXTAUTH_URL": "https://anwarulhidayah.develzy.my.id"
  },
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "invocation_logs": true
    }
  }
}
